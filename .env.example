# Chan secrets and network. Copy to `.env` (gitignored) and fill in.
# `python3 scripts/chan.py flash-config` writes this + config.json to the robot.
# Values live in the robot's flash — treat the device like a key holder.

# Wi-Fi the robot joins (2.4 GHz only on ESP32-S3)
WIFI_SSID=your-wifi-name
WIFI_PASSWORD=your-wifi-password

# Gemini Live API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Shared token your coding-agent hooks send as `Authorization: Bearer …`.
# Any long random string, e.g. `openssl rand -hex 24`.
CHAN_AGENT_TOKEN=change-me-to-a-long-random-string

# Reserved for later features (unused in v1, safe to leave empty)
OPENAI_API_KEY=
GITHUB_TOKEN=
